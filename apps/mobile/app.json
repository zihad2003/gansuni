{
  "expo": {
    "name": "Gansuni",
    "slug": "gansuni",
    "scheme": "gansuni",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "jsEngine": "hermes",

    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#000000"
    },

    "ios": {
      "supportsTablet": true,
      "supportsIPad": true,
      "bundleIdentifier": "app.gansuni.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": ["audio", "fetch"],
        "NSAppleMusicUsageDescription": "Allow Gansuni to access your music library to play songs.",
        "NSMediaLibraryUsageDescription": "Allow Gansuni to access your media library.",
        "NSMicrophoneUsageDescription": "Allow Gansuni to access microphone for voice search (optional).",
        "UILaunchStoryboardName": "SplashScreen",
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      },
      "bundleShortVersion": "0.1.0"
    },

    "android": {
      "package": "app.gansuni.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WAKE_LOCK",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "com.google.android.gms.permission.AD_ID"
      ]
    },

    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/SpotifyMixUI-Regular.otf",
            "./assets/fonts/SpotifyMixUI-Bold.otf",
            "./assets/fonts/SpotifyMixUI-Book.otf",
            "./assets/fonts/SpotifyMixUI-Medium.otf"
          ]
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow Gansuni to access your microphone.",
          "appleMusic": {
            "subscribed": true
          }
        }
      ],
      [
        "react-native-track-player",
        {
          "forwardJumpInterval": 15,
          "backwardJumpInterval": 15,
          "stopWithApp": true,
          "alwaysPauseOnInterruption": true
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true,
      "baseUrl": "./"
    },

    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "gansuni-project-uuid"
      }
    },

    "runtimeVersion": {
      "policy": "appVersion"
    },

    "updates": {
      "url": "https://u.expo.dev/gansuni",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },

    "assetBundlePatterns": [
      "assets/fonts/*",
      "assets/images/*"
    ],

    "owner": "gansuni"
  }
}
