{
  "name": "gansuni",
  "version": "0.1.0",
  "private": true,
  "description": "Gansuni (গানশুনি) — A Spotify-like audio streaming ecosystem",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "turbo db:generate",
    "db:push": "turbo db:push",
    "db:migrate": "turbo db:migrate",
    "db:studio": "turbo db:studio",
    "web": "pnpm --filter @gansuni/web",
    "mobile": "pnpm --filter @gansuni/mobile"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "packageManager": "pnpm@9.7.0"
}
